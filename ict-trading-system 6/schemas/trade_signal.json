{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TradeSignal",
  "description": "Output of the Strategy Decision Engine",
  "type": "object",
  "required": ["timestamp", "strategy_id", "symbol", "direction", "confidence", "entry_type", "entry_price", "stop_price", "targets", "reward_risk", "session"],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "strategy_id": {"type": "string", "pattern": "^[a-z_]+_v\\d+$"},
    "symbol": {"type": "string"},
    "direction": {"type": "string", "enum": ["long", "short"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence_breakdown": {
      "type": "object",
      "properties": {
        "p_setup": {"type": "number", "minimum": 0, "maximum": 1},
        "ev_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "regime_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "exec_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "structural_clarity": {"type": "number", "minimum": 0, "maximum": 1},
        "correlation_confirm": {"type": "number", "minimum": 0, "maximum": 1},
        "session_timing": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "entry_type": {"type": "string", "enum": ["market", "limit", "stop"]},
    "entry_price": {"type": "number"},
    "stop_price": {"type": "number"},
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["price", "pct_close"],
        "properties": {
          "price": {"type": "number"},
          "pct_close": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "invalidation": {"type": "string"},
    "reward_risk": {"type": "number", "minimum": 0},
    "confluence_tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "regime": {"type": "string", "enum": ["reversal_day", "trend_day", "chop", "news_driven", "unknown"]},
    "session": {"type": "string"},
    "market_state_ref": {"type": "string"}
  }
}
